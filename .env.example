# ============================================================
# VARIABLES DE ENTORNO - TIEMPO BAKERY
# ============================================================
# Copia este archivo como .env.local y completa los valores.
# NUNCA subas .env.local al repositorio.
#
# Marca: [required] = obligatorio, [optional] = opcional
# Las variables con "o" son alternativas de la misma configuración.

# ------------------------------------------------------------
# DATABASE [required — at least one connection URL]
# ------------------------------------------------------------

# URL de Prisma Accelerate (producción con pool de conexiones)
# [required*] Formato: prisma+postgres://accelerate.prisma-data.net/?api_key=...
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=..."

# URL directa a PostgreSQL (migraciones en local, sin pool)
# [required*] Formato: postgres://user:pass@host:5432/dbname?sslmode=require
DIRECT_URL="postgres://user:password@localhost:5432/tiempo_bakery?sslmode=require"

# --- Supabase: estas variables son alternativas automáticas ---
# POSTGRES_PRISMA_URL o  →  reemplaza DATABASE_URL
# POSTGRES_URL_NON_POOLING o  →  reemplaza DIRECT_URL
# POSTGRES_URL o  →  fallback para ambos

# ------------------------------------------------------------
# STRIPE (payments) [optional — at least one payment provider]
# ------------------------------------------------------------

# Secret key del backend (sk_test_... para desarrollo, sk_live_... para producción)
STRIPE_SECRET_KEY="sk_test_..."

# Publishable key (exposta al cliente)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Webhook signing secret (obtenido con `stripe listen` o desde el dashboard)
STRIPE_WEBHOOK_SECRET="whsec_..."

# ------------------------------------------------------------
# MERCADO PAGO (payments) [optional — at least one payment provider]
# ------------------------------------------------------------

# Access token de Mercado Pago
MERCADOPAGO_ACCESS_TOKEN="APP_USR-..."

# Client secret (usado por webhooks de Mercado Pago)
MERCADOPAGO_CLIENT_SECRET="..."

# ------------------------------------------------------------
# APP CONFIG
# ------------------------------------------------------------

# URL pública del sitio (usada por checkout, webhooks, emails)
# [required] En Vercel se puede omitir si VERCEL_URL está seteado
NEXT_PUBLIC_URL="http://localhost:3000"

# ------------------------------------------------------------
# ADMIN AUTHENTICATION
# ------------------------------------------------------------

# Password para login del panel admin [required]
ADMIN_PASSWORD="change_me_in_production"

# Secret para firmar JWT de admin [required]
JWT_SECRET="change_me_in_production"

# ------------------------------------------------------------
# EMAILS TRANSACCIONALES (RESEND) [optional]
# ------------------------------------------------------------

# API key de Resend
RESEND_API_KEY="re_..."

# From address para emails (debe ser dominio verificado o usar onboarding@resend.dev)
ORDER_EMAIL_FROM="Tiempo Bakery <onboarding@resend.dev>"

# Emails de notificación interna (separados por coma)
ORDER_NOTIFICATION_EMAILS="pedidos@tiempobakery.com"

# ------------------------------------------------------------
# SUPABASE STORAGE (uploads persistentes) [optional]
# ------------------------------------------------------------
# Requerido para uploads de imágenes en producción.
# En desarrollo local se usa fallback a disco.

NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# ------------------------------------------------------------
# RATE LIMITING (Upstash Redis o Vercel KV) [optional]
# ------------------------------------------------------------
# Sin estas variables, el rate limiting usa un fallback en memoria (no persiste entre reinicios).
# Elegí UN proveedor:

# Opción A: Upstash Redis
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AXXX..."

# Opción B: Vercel KV (alternativa, mismo formato)
# KV_REST_API_URL="https://your-kv-store.vercel-storage.com"
# KV_REST_API_TOKEN="AXXX..."

# ------------------------------------------------------------
# CRON JOBS [optional]
# ------------------------------------------------------------
# Secret para autenticar requests internos de Vercel Cron
CRON_SECRET="your_cron_secret"
